# ===========================================================================
# ARGUS: Vision Shield & Token Guardian Environment Configuration
# ===========================================================================

# Operational mode: auto (default hybrid) | local | direct
ARGUS_MODE=auto

# Default capture source: desktop | bluestacks
ARGUS_SOURCE=desktop

# ADB connection port for Android / BlueStacks (Default: 6175)
ARGUS_ADB_PORT=6175

# Hardware acceleration: true (CUDA GPU) | false (CPU)
ARGUS_USE_GPU=true
